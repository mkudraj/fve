{
  "name": "faceit-investigator",
  "version": "0.1.0",
  "description": "FACEIT Pre-Match Lobby Network Investigator - CDP-based traffic analyzer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --loader ts-node/esm src/index.ts",
    "capture": "node --loader ts-node/esm src/index.ts --capture",
    "analyze": "node --loader ts-node/esm scripts/analyze.ts",
    "report": "node --loader ts-node/esm scripts/analyze.ts --report-only",
    "typecheck": "tsc --noEmit",
    "test": "node --loader ts-node/esm --test src/**/*.test.ts"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
