{
  "name": "faceit-investigator",
  "version": "0.1.0",
  "description": "FACEIT Pre-Match Lobby Network Investigator - CDP-based traffic analyzer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/index.js",
    "capture": "npm run build && node dist/src/index.js --capture",
    "analyze": "npm run build && node dist/scripts/analyze.js",
    "report": "npm run build && node dist/scripts/analyze.js --report-only",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\""
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
